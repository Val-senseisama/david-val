# Email (server-side, used by api/contact.ts on Vercel)
# These are NOT prefixed with VITE_ so they are never exposed to the browser.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Where contact-form submissions are delivered (your inbox).
# With the default sender below, Resend only allows sending to your own
# Resend account email until you verify a domain.
CONTACT_TO_EMAIL=you@example.com 

# Sender address. Defaults to onboarding@resend.dev (test sender).
# Set to an address on a domain you've verified in Resend for production
# and to make the auto-reply to senders work.
CONTACT_FROM_EMAIL=onboarding@resend.dev
